rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection — authenticated users can read/write their own document
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.role == 'customer';
      allow update: if request.auth != null && request.auth.uid == uid
        && !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Offers collection — readable by any authenticated user
    match /offers/{offerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Stamp log — placeholder collection
    // Only readable by the owning user, writable by Cloud Functions (admin SDK)
    match /stamp_log/{logId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Only via Cloud Functions
    }
  }
}
